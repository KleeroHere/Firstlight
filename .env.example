# Firstlight — environment.
#
# Copy to engine/.env.local (which is gitignored, and which the engine scripts
# load themselves), or export these in your shell. Never commit real values:
# every key below is a spending key or an access key.
#
# Nothing here is required to run the example series — the three README
# commands (build_prompts -> make_synthetic_takes -> assemble_video) touch no
# paid service. Each variable unlocks one stage or one backend, and the
# pipeline says which one is missing rather than failing silently.

# --- Stills and motion -------------------------------------------------------

# WaveSpeed API. Unlocks both cloud stages: start frames / end keys
# (engine/wavespeed_stills.mjs, called by engine/auto_storyboard.py) and clip
# generation through Kling / Seedance / Wan (engine/wavespeed_batch.mjs).
# Billed per image and per clip; every call is booked to
# reports/wavespeed-spend.json, and a run refuses to start if the account
# balance is below its own estimate.
WAVESPEED_API_KEY=

# Google Gemini. Unlocks the default keyframe backend — the image-edit API that
# holds up to five character reference sheets at once, which is what keeps a
# face the same face across forty frames. Read by engine/gemini_shots.mjs,
# engine/gemini_frames.mjs, engine/flf_keys.mjs, engine/krupno.mjs and
# engine/fix_shot.mjs. Without it, switch backends.keys to "klein" and generate
# frames locally, free.
GEMINI_API_KEY=

# --- Narration ---------------------------------------------------------------

# ElevenLabs. Unlocks narration synthesis in engine/tts_all.mjs — one call per
# line, cached under takes/<roll>/vo/, so a re-cut costs nothing and the key is
# not needed again after a successful pass. The variable NAME is declared in
# engine/pipeline.config.json (audio.elevenlabs.apiKeyEnv); the value only ever
# comes from the environment.
ELEVENLABS_API_KEY=

# --- The acceptance / storyboard agent ---------------------------------------

# Anthropic API. Unlocks engine/claude_agent.mjs — the agent that reads contact
# sheets and metrics and returns an acceptance verdict, and that can draft a
# storyboard from a scenario. Without it the same script writes a review packet
# for a human instead of calling out.
ANTHROPIC_API_KEY=

# Optional model override for that agent. Default: claude-sonnet-5.
# Read by engine/claude_agent.mjs.
ANTHROPIC_MODEL=

# --- Motion backends other than WaveSpeed ------------------------------------

# Local ComfyUI, host:port. Unlocks the free local backends — Flux.2 Klein
# keyframes (engine/klein_keys.py) and local Wan 2.2 first-last-frame motion.
# Default when unset: 127.0.0.1:8188.
COMFY_HOST=127.0.0.1:8188

# Where that ComfyUI reads its input images from. Read by engine/klein_keys.py,
# which copies references into it. Default: ~/ComfyUI/input.
COMFY_INPUT=

# RunPod API key. Unlocks the rented-GPU motion backend: pod lifecycle and the
# remote ComfyUI that engine/flf_batch.mjs --host <pod-url> shoots against.
RUNPOD_API_KEY=

# The rented pod's id, so engine/pod_exec.mjs can run commands on it when SSH
# is not available.
POD_ID=

# What the rented GPU costs per hour, for the spend report only. Read by
# engine/comfy_batch.mjs and engine/comfy_frames.mjs. Default: 0.74.
POD_USD_PER_HOUR=

# --- Release -----------------------------------------------------------------

# GitHub token, used by `gh` to attach built episodes and the packaged
# Firstlight.exe to a release. Needs no more than repo/release write.
GITHUB_TOKEN=
