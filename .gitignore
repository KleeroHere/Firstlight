node_modules/
ui/dist/
ui/ui-shots/

# build/build-exe.mjs output: a copy of the Node binary plus everything it
# packages (engine/, ui/dist/, the example workspace) — rebuilt on demand,
# not committed.
build/out/
build/dist/

# The example series is committed as scenarios; everything the pipeline makes
# from it is reproducible with the three commands in the README.
workspace/prompts/compiled/
workspace/prompts/sheets/
workspace/takes/
workspace/build/
workspace/out/
workspace/kits/
workspace/plans/
workspace/reshoot.json
workspace/spend.json
workspace/*.log
workspace/*/acceptance.json

# The packaged .exe's own runtime log, written beside it — see LOG_PATH in
# ui/server/server.mjs. Not workspace state, and not something to commit.
firstlight.log

# Keys and hosts live in the environment, never here.
.env
.env.*
!.env.example
# ...except this one: it holds no secret, just the flag that switches a build
# to demo mode (VITE_DEMO=1) — see ui/vite.config.ts and .github/workflows/pages.yml.
!ui/.env.demo
engine/.env.local
reports/
__pycache__/

# Explainer source clips are generated, like every other take in this repo:
# rebuild them with the three scripts beside them (see docs/demo/motion/manifest.json).
# The finished explainer, "docs/demo/How Firstlight works.mp4", IS committed —
# it is a deliverable, not an intermediate.
docs/demo/motion/*.mp4
docs/demo/motion/*.webm

# Review packets: the verdicts, the checklist and the item list are the record
# and are committed. The contact sheets inside them are copies of
# reports/qa-<roll>/, which is generated — the committed montages of the same
# frames are docs/demo/review/.
workspace/*/_review/*/sheets/
