        },
        {
          "id": "s1",
          "kind": "scene",
          "plate": "Step 1. Hear the forecast out",
          "t": [
            6,
            21
          ],
          "chars": [
            "ines"
          ],
          "bg": "harbour-office",
          "img": "Ines at the harbour office desk, the radio handset held to her ear in one hand, an open logbook and a pencil in front of her, the window behind her showing a grey hazy evening over the pier.",
          "anim": "Ines lifts the handset to her ear, listens, and sets it back down on its cradle.",
          "vo": "The evening forecast comes in over the harbour set. Fog after nine. That one line is the trigger for everything that follows, so the clerk hears it out to the end before she writes anything down.",
          "frames": [
            "plan1_master.jpg",
            "plan2_master.jpg",
            "plan3_master.jpg"
          ],
          "takes": [
            "s1_take1.mp4"
