    {
      "id": "s2",
      "kind": "scene",
      "plate": "Step 2. Test the horn — two short, one long",
      "t": [
        21,
        36
      ],
      "chars": [
        "mara",
        "tomas"
      ],
      "bg": "lantern-room",
      "img": "Mara stands at the signal panel in the lantern room with one hand closed around a long brass lever; Tomas is beside her with his notebook open in both hands, watching the panel.",
      "anim": "Mara pulls the lever down, holds it, and lets it rise back; Tomas marks two short strokes and one long stroke in his open notebook.",
      "vo": "The keeper tests the horn from the panel. Two short blasts, then one long. The apprentice counts what he hears, not what he expects to hear — that difference is the whole point of a test.",
      "frames": [
        "plan4_master.jpg",
        "plan5_master.jpg",
        "plan6_master.jpg"
      ],
      "takes": [
        "s2_take1.mp4"
      ],
      "rejected": 0
    },
    {
      "id": "s3",
      "kind": "scene",
      "plate": "Step 3. Write the count, not the memory",
      "t": [
        36,
        51
      ],
      "chars": [
        "tomas"
      ],
      "bg": "lantern-room",
      "img": "Tomas at the chart table of the lantern room, an open logbook under his hands and a pencil poised over a ruled column, the great lens standing behind him.",
      "anim": "Tomas draws the pencil across the ruled column from left to right, writing one short line, then lifts the pencil clear of the page and lays it down flat across the open page.",
      "vo": "Then it goes into the book. The time, the count, and who heard it. A log nobody can argue with later is worth more than anyone's memory of a quiet evening.",
      "frames": [
        "plan7_master.jpg",
        "plan8_master.jpg",
        "plan9_master.jpg"
      ],
      "takes": [
        "s3_take1.mp4"
      ],
