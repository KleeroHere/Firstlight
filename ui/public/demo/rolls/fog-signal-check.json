      ],
      "chars": [
        "tomas"
      ],
      "bg": "pier",
      "img": "Tomas on the stone pier at dusk, a handheld radio raised in one hand, his other hand resting on an iron bollard, the lighthouse lit behind him.",
      "anim": "Tomas raises the radio, presses the side key with his thumb, and lowers it again.",
      "vo": "Last, somebody outside has to say they heard it. The apprentice calls the office from the pier, the clerk logs the time, and the check is finished.",
