    {
      "id": "s1",
      "kind": "scene",
      "plate": "Step 1. Keys, hand to hand",
      "t": [
        6,
        21
      ],
      "chars": [
        "mara",
        "tomas"
      ],
      "bg": "lantern-room",
      "img": "Mara stands beside the great lens holding a small ring of brass keys out over an open palm; Tomas stands facing her with one hand held open and level, waiting for them.",
      "anim": "Mara lowers the ring of keys onto the open palm and takes her hand back; Tomas closes his fingers around the keys and lowers his hand.",
      "vo": "A shift ends when the keys are in somebody else's hand and both people have watched it happen. The keeper gives them over; the apprentice closes his fingers. Nothing is signed, and it already counts.",
      "frames": [
        "plan1_master.jpg",
        "plan2_master.jpg",
        "plan3_master.jpg"
      ],
      "takes": [
        "s1_take1.mp4"
      ],
      "rejected": 0
    },
    {
      "id": "s2",
      "kind": "scene",
      "plate": "Step 2. The board ashore agrees",
      "t": [
        21,
        36
      ],
      "chars": [
        "ines"
      ],
      "bg": "harbour-office",
      "img": "Ines at the harbour office desk, a small blank wooden tag held between two fingers above a row of brass pegs on the wall board, the radio set on the desk beside her.",
      "anim": "Ines lifts the blank wooden tag off its peg and hangs it on the next peg along.",
      "vo": "Ashore, the clerk hears it on the radio and moves one wooden tag across the board. That tag is the harbour's entire answer to the question of who is on the light tonight.",
      "frames": [
        "plan4_master.jpg",
        "plan5_master.jpg",
        "plan6_master.jpg"
      ],
      "takes": [
        "s2_take1.mp4"
      ],
      "rejected": 0
    },
    {
      "id": "s3",
      "kind": "scene",
      "plate": "Step 3. Cast off the last line",
      "t": [
        36,
        51
      ],
      "chars": [
        "mara",
        "tomas"
      ],
      "bg": "pier",
      "img": "Mara crouches over a thick mooring rope looped around an iron bollard on the stone pier; Tomas stands a step behind her holding a coil of the same rope against his chest with both hands.",
      "anim": "Mara lifts the loop of rope off the bollard and lowers it onto the stones; Tomas draws the slack coil in against his chest.",
      "vo": "Then the last boat goes. The keeper casts off the line herself, the way she has every evening for thirty years, and the pier belongs to one person again.",
      "frames": [
        "plan7_master.jpg",
        "plan8_master.jpg",
        "plan9_master.jpg"
      ],
      "takes": [
        "s3_take1.mp4"
      ],
      "rejected": 0
    },
    {
      "id": "s4",
      "kind": "scene",
      "plate": "Step 4. One lift of the lantern",
      "t": [
        51,
        66
      ],
      "chars": [
        "tomas"
      ],
      "bg": "pier",
      "img": "Tomas alone on the stone pier at dusk, a storm lantern held out at shoulder height in one hand, the lit lighthouse above and behind him, dark water beyond the stones.",
      "anim": "Tomas raises the storm lantern to shoulder height, holds it steady, and lowers it again.",
      "vo": "One lift of the lantern says the same thing every night: seen you, you are clear. Then the apprentice turns back up the steps, and the light is his until morning.",
      "frames": [
        "plan10_master.jpg",
        "plan11_master.jpg",
